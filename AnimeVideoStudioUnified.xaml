              <Border Grid.Row="2" Background="#101A27" BorderBrush="#24384E" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,12"><TextBlock Name="MainGuideText" Text="Todavia no empezo el proceso. Elige un video, revisa sus datos y despues prueba 6 segundos." TextWrapping="Wrap" Foreground="#D6E5F7"/></Border>
              <TextBox Name="MainLogBox" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#070B11" Foreground="#B9FFD6" BorderBrush="#1B2B3D" BorderThickness="1" Padding="10"/>
            </Grid>
          </Border>
          <Grid Grid.Row="4" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#9CB1C8" Text="El archivo original no se modifica. La salida se guarda en la carpeta del trabajo."/><Button Name="MainOpenButton" Grid.Column="1" Content="Ver carpeta" Margin="10,0,0,0" IsEnabled="False"/><Button Name="MainToEbButton" Grid.Column="2" Content="Ir a EbSynth" Margin="10,0,0,0" Background="#F97316"/><Button Name="MainPreviewButton" Grid.Column="3" Content="Vista previa" Margin="10,0,0,0" Background="#2563EB" IsEnabled="False"/><Button Name="MainStartButton" Grid.Column="4" Content="Crear final" Margin="10,0,0,0" Background="#10B981" IsEnabled="False"/></Grid>
        </Grid>
      </TabItem>
